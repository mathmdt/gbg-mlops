# Copy to .env (ignored by Git). Development values only: never put real secrets here.

# MLflow tracking server and model registry
MLFLOW_TRACKING_URI=http://localhost:5000
# S3-compatible artifact store (MinIO in dev)
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio-dev
AWS_SECRET_ACCESS_KEY=minio-dev-password

# Served model
MODEL_NAME=gbg-risk
MODEL_ALIAS=champion
RISK_THRESHOLD=0.5
