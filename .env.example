# Copy to .env (ignored by Git; `make up` does it if missing).
# Development values only: never put real secrets here.

# --- Clients on your machine (scripts, training, local API) ---
# MLflow is published on 5001 because macOS uses 5000 for AirPlay Receiver.
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
# MinIO credentials (also used as the MinIO root user in dev)
AWS_ACCESS_KEY_ID=minio-dev
AWS_SECRET_ACCESS_KEY=minio-dev-password

# Served model
MODEL_NAME=gbg-risk
MODEL_ALIAS=champion
RISK_THRESHOLD=0.5

# --- Docker Compose only ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow-dev-password
POSTGRES_DB=mlflow
# Host ports (container ports stay 5000 / 9000 / 9001 / 8000 / 4200)
MLFLOW_PORT=5001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
PREFECT_PORT=4200
